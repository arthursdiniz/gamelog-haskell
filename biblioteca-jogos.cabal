cabal-version: 3.0
name: biblioteca-jogos
version: 0.1.0.0
build-type: Simple
data-files: index.html, style.css, script.js
extra-source-files: banco.sql, migracao-biblioteca.sql,
                    migracao-preservar-legado.sql, README.md

executable biblioteca-jogos
  main-is: Main.hs
  autogen-modules: Paths_biblioteca_jogos
  other-modules: Paths_biblioteca_jogos
  default-language: Haskell2010
  ghc-options: -Wall -threaded
  build-depends:
      aeson
    , base >= 4.14 && < 5
    , http-types
    , postgresql-simple
    , scientific
    , servant-server
    , text
    , wai
    , warp
